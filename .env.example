
# Copy this file to .env and fill in real values.
# .env is never committed.

APP_NAME=consumershield
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Use your own Neon connection string in .env only.
# This is a safe local placeholder.
DATABASE_URL=postgresql://localhost:5432/consumershield

# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env, GitHub Secrets and Render only. Never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
